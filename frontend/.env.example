# ========================================
# Frontend Environment Variables
# Set these in Vercel → Project → Settings → Environment Variables
# ========================================

# ── Supabase ──
# Both are public by design: the anon key is safe in the browser precisely
# because Row Level Security decides what it can reach.
# The service_role key must NEVER appear here — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Supabase — Preview override (dev database) ──
# On Vercel, NEXT_PUBLIC_SUPABASE_URL/ANON_KEY above are synced by the
# Supabase↔Vercel marketplace integration for ALL environments — always the
# production project. Vercel does not let an integration-managed variable be
# edited or scoped per environment (its menu has no Edit, only Manage
# Connection / Rotate / Delete). To point the Preview deployment at a
# separate dev Supabase project instead, set these two — ordinary variables,
# not integration-owned — scoped to the Preview environment ONLY. See
# lib/supabase-env.ts: when present they win; on Production they are unset,
# so this never touches what production sees.
NEXT_PUBLIC_SUPABASE_URL_PREVIEW=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PREVIEW=

# ── Backend ──
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Absolute URL of this app — used for OAuth and email redirect targets.
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# ── Google sign-in ──
# Lets Google render its button on OUR origin, so the consent screen says
# "pravotek.com" instead of the Supabase project host. Public by design — a
# client id is an identifier, not a secret.
#
# This MUST be the same client id configured in Supabase → Authentication →
# Google (or listed there under "Authorized Client IDs"). Supabase checks the
# `aud` claim of the ID token against it; a different client is rejected no
# matter how correct everything else is.
#
# Google Cloud → Clients → Authorized JavaScript origins must list every host
# this runs on: production, the Vercel URL, and http://localhost:3000.
#
# Leave empty and sign-in falls back to the redirect flow — the old behaviour,
# supabase.co visible and all. Nothing breaks without it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Second factor ──
# Signs the cookie that proves a session cleared 2FA. Server-only: no
# NEXT_PUBLIC_ prefix, because a browser that could read it could mint the
# cookie itself and walk past the check.
# Generate with: openssl rand -hex 32
# Without it the middleware throws rather than letting anyone through.
MFA_COOKIE_SECRET=

# ── Admin ──
# Email allowed into /admin/*. Server-only.
ADMIN_EMAIL=
