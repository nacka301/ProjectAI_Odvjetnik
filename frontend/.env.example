# ========================================
# Frontend Environment Variables
# Set these in Vercel → Project → Settings → Environment Variables
# ========================================

# ── Supabase ──
# Both are public by design: the anon key is safe in the browser precisely
# because Row Level Security decides what it can reach.
# The service_role key must NEVER appear here — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Backend ──
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Absolute URL of this app — used for OAuth and email redirect targets.
NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app

# ── Second factor ──
# Signs the cookie that proves a session cleared 2FA. Server-only: no
# NEXT_PUBLIC_ prefix, because a browser that could read it could mint the
# cookie itself and walk past the check.
# Generate with: openssl rand -hex 32
# Without it the middleware throws rather than letting anyone through.
MFA_COOKIE_SECRET=

# ── Admin ──
# Email allowed into /admin/*. Server-only.
ADMIN_EMAIL=
