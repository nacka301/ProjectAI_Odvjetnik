# ========================================
# Backend Environment Variables
# Set these in Render Dashboard → Environment
# ========================================

# ── Supabase ──
# URL + the two keys. ANON_KEY is what user-scoped queries travel with, so Row
# Level Security applies; SERVICE_KEY bypasses RLS and is used only for
# identity resolution, MFA secrets, audit writes, provisioning and admin views.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Mandatory. Without it the backend refuses to start rather than fall back to
# trusting whatever the caller claims. Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret

# Encrypts TOTP secrets at rest (32 bytes, base64)
TOTP_ENCRYPTION_KEY=

# Admin email allowed into /api/admin/*, /api/rag/*
ADMIN_EMAIL=

# OpenRouter (unified AI gateway)
OPENROUTER_API_KEY=sk-or-your-key-here

# Tavily Search
Tavily__ApiKey=tvly-your-key-here

# CORS — Frontend URL (Vercel deployment)
FRONTEND_URL=https://your-frontend.vercel.app

# Port (Render provides this automatically)
PORT=8080
